# ==========================================
# GYM MANAGEMENT SYSTEM — ENVIRONMENT CONFIG
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ==========================================

# ----- SERVER -----
PORT=5000
NODE_ENV=production

# ----- DATABASE -----
DB_HOST=localhost
DB_USER=gym_user
DB_PASSWORD=your_strong_password_here
DB_NAME=rr_gym
DB_PORT=3306

# ----- JWT (REQUIRED — generate a strong random string) -----
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_string

# ----- CORS (your deployed frontend URL — no trailing slash) -----
# Use your Netlify URL (or custom domain if configured)
FRONTEND_URL=https://your-app.netlify.app
# www version or custom domain (optional second origin)
PROD_URL=https://www.yourdomain.com

# ----- NODE ENV (IMPORTANT: must be "production" for cross-origin cookies) -----
NODE_ENV=production

# ----- GYM BRANDING -----
GYM_NAME=RR POWER AND WELLNESS GYM
GYM_EMAIL=your@gmail.com
GYM_PHONE=+91 XXXXXXXXXX
GYM_ADDRESS=Your Gym Address Here

# ----- EMAIL (Gmail App Password) -----
# Enable 2FA on Gmail → myaccount.google.com/apppasswords → create App Password
EMAIL=yourgym@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_16_chars

# ----- SMS (Fast2SMS API key — optional) -----
FAST2SMS_API_KEY=your_fast2sms_api_key

# ----- AI CHATBOT (OpenRouter API key — optional) -----
OPENROUTER_API_KEY=your_openrouter_api_key
